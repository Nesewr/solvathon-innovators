# 로컬: 이 파일을 .env 로 복사. 배포: Render → Environment 에 같은 키를 입력
PORT=8787

# ── 비밀값 (저장소에 절대 커밋하지 않음) ──
GEMINI_API_KEY=            # Gemini API 키. 없으면 AI 풀이가 예시 모드
GOOGLE_CLIENT_ID=          # OAuth 클라이언트 ID. 없으면 구글 버튼이 뜨지 않음

# ── 운영 모드 스위치 ──
REQUIRE_LOGIN=0            # 1: 글·댓글·투표·분실물·오답노트·AI 풀이에 로그인 필수 (운영 권장)
ALLOW_DEMO_LOGIN=1         # 0: 이메일 직접 입력 로그인 금지, 구글 로그인만 (운영 권장)
ALLOW_RESET=1              # 0: 데모 데이터 초기화 API 금지 (운영 권장)
SEED=1                     # 0: 데모 글 없이 빈 상태로 시작

GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:8765,https://nesewr.github.io
DB_FILE=./db.json
