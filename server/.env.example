# 복사해서 .env 로 만들거나(로컬), Render 환경변수에 입력(배포)
PORT=8787
# Gemini API 키 (없으면 /api/solve 가 비활성 → 프론트가 브라우저 키 또는 예시 풀이로 동작)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Google OAuth Client ID (없으면 구글 토큰 검증 생략, 이메일 직접 입력 로그인만)
GOOGLE_CLIENT_ID=
# 허용 출처 (쉼표). 비우면 모두 허용
ALLOWED_ORIGINS=http://localhost:8765,https://nesewr.github.io
# 데모용: 이메일 직접 입력 로그인 허용(1) / 데이터 초기화 API 허용(1)
ALLOW_DEMO_LOGIN=1
ALLOW_RESET=1
# 데이터 파일 경로
DB_FILE=./db.json
